# Dev stack settings (compose.yaml). Copy to .env (git-ignored) and change the values:
#   cp .env.example .env
# Every value here is a DEV PLACEHOLDER. Never put production secrets in this file.
# Passwords end up inside postgres:// URLs: use only letters, digits, '-' and '_'.

# PostgreSQL superuser of the dev container (used only by the init script and psql in scripts/e2e-login.sh).
POSTGRES_PASSWORD=dev-postgres-change-me
# The three roles of SPEC §11.9, created by deploy/initdb/10-roles.sh on the first start of an empty volume.
IL_OWNER_PASSWORD=dev-owner-change-me
IL_APP_PASSWORD=dev-app-change-me
IL_MAINT_PASSWORD=dev-maint-change-me
# Host port for the compose db (127.0.0.1 only). 5433 avoids a local PostgreSQL on 5432.
DB_PORT=5433

# API settings (SPEC §11.10). dev = text logs (compose sets it for its containers too).
APP_ENV=dev
# APP_ORIGIN must be the proxy origin, or the CSRF/Origin check refuses every write.
APP_ORIGIN=https://localhost:8443
# 32+ random bytes, base64. Generate your own with: openssl rand -base64 32
APP_SECRET=ZGV2LW9ubHktYXBwLXNlY3JldC1kby1ub3QtdXNlLWluLXByb2QhIQ==
LOG_LEVEL=info

# Host-side DSNs for `make migrate` and `make run` against the compose db (load with: set -a; . ./.env; set +a).
# Inside compose the services use their own DSNs (host `db`), set in compose.yaml.
MIGRATE_DATABASE_URL="postgres://il_owner:${IL_OWNER_PASSWORD}@localhost:${DB_PORT}/impex?sslmode=disable"
DATABASE_URL="postgres://il_app:${IL_APP_PASSWORD}@localhost:${DB_PORT}/impex?sslmode=disable"
MAINT_DATABASE_URL="postgres://il_maint:${IL_MAINT_PASSWORD}@localhost:${DB_PORT}/impex?sslmode=disable"
